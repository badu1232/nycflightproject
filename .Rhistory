title = "Airports with Unusual Coordinates",
x = "Longitude",
y = "Latitude",
color = "Time zone"
)
#| label: strange-table
strange_airports <- airports |> filter(lon > 0)
strange_airports |>
select(faa, name, lat, lon, tzone) |>
kable(digits = 2)
flights |> left_join(airports, join_by(dest == faa)) |> glimpse()
airports |> left_join(flights, join_by(faa == dest)) |> glimpse()
#| label: join-counts
n_join1 <- flights |> left_join(airports, join_by(dest == faa)) |> nrow()
n_join2 <- airports |> left_join(flights, join_by(faa == dest)) |> nrow()
n_unused_airports <- airports |> anti_join(flights, join_by(faa == dest)) |> nrow()
n_lost_flights    <- flights |> anti_join(airports, join_by(dest == faa)) |> nrow()
# Airports with no flights departing from them
airports |>
anti_join(flights, join_by(faa == origin)) |>
nrow()
# Airports with no flights arriving at them
airports |>
anti_join(flights, join_by(faa == dest)) |>
nrow()
# Flights whose destinations are not listed in airports (by destination)
flights |>
anti_join(airports, join_by(dest == faa)) |>
count(dest, sort = TRUE)
# Count how often each destination occurs
flights |>
count(dest, sort = TRUE)
# Are there duplicate FAA codes in airports? (should return zero rows)
airports |>
count(faa) |>
filter(n > 1)
#| label: own-question-plot
#| warning: false
delay_by_hour <- flights |>
filter(!is.na(dep_delay)) |>
summarize(
mean_dep_delay = mean(dep_delay),
n_flights = n(),
.by = c(hour, origin)
)
ggplot(
data = delay_by_hour,
mapping = aes(x = hour, y = mean_dep_delay, color = origin)
) +
geom_line() +
geom_point() +
geom_hline(yintercept = 0, linetype = "dotted") +
labs(
title = "Mean Departure Delay by Scheduled Hour of the Day",
x = "Scheduled departure hour",
y = "Mean departure delay (minutes)",
color = "Origin airport"
)
#| label: own-question-table
delay_by_hour_all <- flights |>
filter(!is.na(dep_delay)) |>
summarize(
mean_dep_delay = mean(dep_delay),
n_flights = n(),
.by = hour
) |>
arrange(hour)
delay_by_hour_all |>
kable(
col.names = c("Scheduled hour", "Mean departure delay (minutes)", "Number of flights"),
digits = 1
)
#| label: packages-data-functions
#| message: false
#| warning: false
# 1. Load packages
library(tidyverse)
# 2. Import datasets
who <- read_csv("data/WHO-COVID-19.csv")
wdi <- read_csv("data/WDI.csv")
# 3. Convert the date column
who <- who %>%
mutate(Date_reported = as.Date(Date_reported))
# 4. Sort WHO data by country and date
who <- who %>%
arrange(Country, Date_reported)
# 5. Rename WDI variables to shorter names
wdi <- wdi %>%
rename(
urban_pop = `Urban population (% of total population)`,
rural_pop = `Rural population (% of total population)`,
pop_lower_half_median = `Proportion of people living below 50 percent of median income (%)`,
pop = `Population, total`,
pop_older65 = `Population ages 65 and above (% of total population)`,
pop_density = `Population density (people per sq. km of land area)`,
physicians_per_1000 = `Physicians (per 1,000 people)`,
life_expectancy = `Life expectancy at birth, total (years)`,
gdp_per_capita = `GDP per capita, PPP (current international $)`
)
# 7. Create a function to calculate moving averages
smooth3 <- function(x) {
(x + lag(x, 1, default = 0) +
lag(x, 2, default = 0)) / 3
}
smooth7 <- function(x) {
(x + lag(x, 1, default = 0) +
lag(x, 2, default = 0) +
lag(x, 3, default = 0) +
lag(x, 4, default = 0) +
lag(x, 5, default = 0) +
lag(x, 6, default = 0)) / 7
}
smooth10 <- function(x) {
(x + lag(x, 1, default = 0) +
lag(x, 2, default = 0) +
lag(x, 3, default = 0) +
lag(x, 4, default = 0) +
lag(x, 5, default = 0) +
lag(x, 6, default = 0) +
lag(x, 7, default = 0) +
lag(x, 8, default = 0) +
lag(x, 9, default = 0)) / 10
}
# 8. Function for shifting and scaling time series
shiftscale <- function(x, shift, scale) {
lag(x, n = shift, default = 0) * scale
}
#| label: data
#| warning: false
who <- who %>%
arrange(Country, Date_reported) %>%
group_by(Country) %>%
mutate(
New_cases_smooth3 = smooth3(New_cases),
New_cases_smooth7 = smooth7(New_cases),
New_cases_smooth10 = smooth10(New_cases),
New_deaths_smooth3 = smooth3(New_deaths),
New_deaths_smooth7 = smooth7(New_deaths),
New_deaths_smooth10 = smooth10(New_deaths),
Diff_cases_smooth7 = New_cases_smooth7 - lag(New_cases_smooth7, n = 1)
) %>%
ungroup()
# Verify that the variables were created
names(who)
#| label: germany-first-wave
#| warning: false
# Select Germany before 31 August 2020
germany_wave1 <- who %>%
filter(
Country == "Germany",
Date_reported < as.Date("2020-08-31")
)
# Reshape the data for plotting
germany_wave1_long <- germany_wave1 %>%
select(Date_reported, New_cases, New_deaths) %>%
pivot_longer(
cols = c(New_cases, New_deaths),
names_to = "Variable",
values_to = "Count"
)
# Create the time-series plot
ggplot(germany_wave1_long,
aes(x = Date_reported, y = Count, color = Variable)) +
geom_line(linewidth = 0.8) +
labs(
title = "COVID-19 Cases and Deaths in Germany",
subtitle = "First wave: January to August 2020",
x = "Date",
y = "Daily reported numbers",
color = "Variable"
) +
scale_color_manual(
values = c(
"New_cases" = "blue",
"New_deaths" = "red"
),
labels = c(
"New_cases" = "New cases",
"New_deaths" = "New deaths"
)
) +
theme_minimal()
# Highest daily number of cases
peak_cases <- germany_wave1 %>%
slice_max(New_cases, n = 1, with_ties = TRUE) %>%
select(Date_reported, New_cases)
# Highest daily number of deaths
peak_deaths <- germany_wave1 %>%
slice_max(New_deaths, n = 1, with_ties = TRUE) %>%
select(Date_reported, New_deaths)
peak_cases
peak_deaths
#| label: cumulative-cases-deaths
#| warning: false
# 1. Select the four countries
selected_countries <- c(
"Germany",
"Italy",
"France",
"The United Kingdom"
)
# 2. Calculate cumulative cases and deaths
cumulative_data <- who %>%
filter(
Country %in% selected_countries,
Date_reported <= as.Date("2020-08-31")
) %>%
arrange(Country, Date_reported) %>%
group_by(Country) %>%
mutate(
cumulative_cases = cumsum(New_cases),
cumulative_deaths = cumsum(New_deaths)
) %>%
ungroup()
# 3. Reshape data for plotting
cumulative_long <- cumulative_data %>%
select(
Date_reported,
Country,
cumulative_cases,
cumulative_deaths
) %>%
pivot_longer(
cols = c(cumulative_cases, cumulative_deaths),
names_to = "Variable",
values_to = "Total"
)
# 4. Create the facetted graph
ggplot(
cumulative_long,
aes(
x = Date_reported,
y = Total,
color = Country
)
) +
geom_line(linewidth = 0.8) +
facet_wrap(~Variable, scales = "free_y") +
labs(
title = "Cumulative COVID-19 Cases and Deaths",
subtitle = "Germany, Italy, France and the United Kingdom",
x = "Date",
y = "Cumulative total",
color = "Country"
) +
scale_color_brewer(palette = "Set1") +
scale_y_continuous(labels = scales::comma) +
theme_minimal() +
theme(
legend.position = "bottom",
strip.text = element_text(face = "bold")
)
#| label: smoothing-comparison
#| warning: false
# Select Germany until 31 August 2020
germany_smooth <- who %>%
filter(
Country == "Germany",
Date_reported <= as.Date("2020-08-31")
) %>%
select(
Date_reported,
New_cases_smooth3,
New_cases_smooth7,
New_cases_smooth10
)
# Reshape the data
germany_smooth_long <- germany_smooth %>%
pivot_longer(
cols = starts_with("New_cases_smooth"),
names_to = "Smoothing",
values_to = "Smoothed_cases"
)
# Create the comparison plot
ggplot(
germany_smooth_long,
aes(x = Date_reported, y = Smoothed_cases)
) +
geom_line(color = "blue", linewidth = 0.8) +
facet_wrap(~Smoothing, ncol = 1) +
labs(
title = "Smoothed Daily COVID-19 Cases in Germany",
subtitle = "Comparison of 3-day, 7-day and 10-day moving averages",
x = "Date",
y = "Smoothed daily cases"
) +
theme_minimal()
# Check whether the smoothed variables exist
names(who)
#| label: section-1-5-wave1
#| warning: false
# Best values found by trial and error: CHANGE THESE and re-render until
# the two lines overlap best in the second half of March 2020
shift_best <- 7
scale_best <- 0.06
germany_ss <- who %>%
filter(Country == "Germany") %>%
arrange(Date_reported) %>%
mutate(shiftscale_cases = shiftscale(New_cases_smooth7, shift_best, scale_best))
plot_ss <- function(data, from, to) {
data %>%
filter(Date_reported >= as.Date(from), Date_reported <= as.Date(to)) %>%
select(Date_reported, shiftscale_cases, New_deaths_smooth7) %>%
pivot_longer(-Date_reported, names_to = "Series", values_to = "Count") %>%
ggplot(aes(Date_reported, Count, color = Series)) +
geom_line(linewidth = 0.8) +
labs(title = paste0("Germany: shift = ", shift_best, " days, scale = ", scale_best),
x = "Date", y = "Daily count (7-day average)") +
theme_minimal()
}
plot_ss(germany_ss, "2020-03-01", "2020-04-30")
#| label: section-1-5-wave2
#| warning: false
plot_ss(germany_ss, "2020-07-01", "2020-12-31")
#| label: section-1-6
#| warning: false
germany_diff <- who %>%
filter(
Country == "Germany",
Date_reported >= as.Date("2020-03-01"),
Date_reported <= as.Date("2020-04-15")
) %>%
arrange(Date_reported)
# Find the date with the largest increase
germany_diff %>%
slice_max(Diff_cases_smooth7, n = 1, with_ties = TRUE) %>%
select(Date_reported, Diff_cases_smooth7)
# Find the date of the peak of the smoothed cases
germany_diff %>%
slice_max(New_cases_smooth7, n = 1) %>%
select(Date_reported, New_cases_smooth7)
# Prepare data for the two-panel graph
germany_diff_long <- germany_diff %>%
select(Date_reported, New_cases_smooth7, Diff_cases_smooth7) %>%
pivot_longer(
cols = c(New_cases_smooth7, Diff_cases_smooth7),
names_to = "Variable",
values_to = "Value"
)
ggplot(germany_diff_long, aes(x = Date_reported, y = Value)) +
geom_line(color = "blue") +
facet_wrap(~Variable, scales = "free_y", ncol = 1) +
labs(
title = "Germany: Smoothed cases and first differences",
x = "Date",
y = "Value"
) +
theme_minimal()
#| label: section-2-1-data
#| warning: false
# Check missing values in each WDI variable
wdi %>%
summarise(across(everything(), ~sum(is.na(.))))
# Dataset 1: Remove countries with any missing values
wdi_noNA_small <- wdi %>%
drop_na()
# Dataset 2: Remove the two variables with the most missing values,
# then remove countries with missing values in the remaining variables
wdi_noNA_large <- wdi %>%
select(-pop_lower_half_median, -gdp_per_capita) %>%
drop_na()
# Compare the number of countries
cat("Countries in original dataset:", nrow(wdi), "\n")
cat("Countries in small dataset:", nrow(wdi_noNA_small), "\n")
cat("Countries in large dataset:", nrow(wdi_noNA_large), "\n")
#| label: section-2-1-correlation
#| warning: false
# Select numeric variables and calculate correlations
cor_small <- wdi_noNA_small %>%
select(where(is.numeric)) %>%
cor()
cor_large <- wdi_noNA_large %>%
select(where(is.numeric)) %>%
cor()
# Convert correlation matrices into data frames for plotting
cor_small_long <- as.data.frame(as.table(cor_small))
cor_large_long <- as.data.frame(as.table(cor_large))
# Plot correlation matrix for the small dataset
ggplot(cor_small_long, aes(Var1, Var2, fill = Freq)) +
geom_tile() +
geom_text(aes(label = round(Freq, 2)), size = 3) +
scale_fill_gradient2(
low = "blue",
mid = "white",
high = "red",
midpoint = 0,
limits = c(-1, 1)
) +
labs(
title = "Correlation Matrix - Small Dataset",
x = NULL,
y = NULL,
fill = "Correlation"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# Plot correlation matrix for the large dataset
ggplot(cor_large_long, aes(Var1, Var2, fill = Freq)) +
geom_tile() +
geom_text(aes(label = round(Freq, 2)), size = 3) +
scale_fill_gradient2(
low = "blue",
mid = "white",
high = "red",
midpoint = 0,
limits = c(-1, 1)
) +
labs(
title = "Correlation Matrix - Large Dataset",
x = NULL,
y = NULL,
fill = "Correlation"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# Find the strongest positive and negative correlations
get_correlations <- function(cor_matrix) {
cor_matrix[lower.tri(cor_matrix, diag = TRUE)] <- NA
cor_values <- as.data.frame(as.table(cor_matrix)) %>%
filter(!is.na(Freq)) %>%
arrange(desc(Freq))
cat("\nStrongest positive correlations:\n")
print(head(cor_values, 5))
cat("\nStrongest negative correlations:\n")
print(head(arrange(cor_values, Freq), 5))
}
cat("SMALL DATASET")
get_correlations(cor_small)
cat("\nLARGE DATASET")
get_correlations(cor_large)
#| label: section-2-1-correlation-pkg
#| warning: false
# Requires the packages `correlation` and `see`
library(correlation)
wdi_noNA_small %>%
select(where(is.numeric)) %>%
correlation() %>%
summary(redundant = TRUE) %>%
plot()
#| label: section-2-2-missing
#| warning: false
missing_small <- wdi %>%
anti_join(wdi_noNA_small, by = "iso3c") %>%
filter(pop > 1e6) %>%
select(country, iso3c, region, pop)
missing_large <- wdi %>%
anti_join(wdi_noNA_large, by = "iso3c") %>%
filter(pop > 1e6) %>%
select(country, iso3c, region, pop)
knitr::kable(missing_small, format.args = list(big.mark = ","))
knitr::kable(missing_large, format.args = list(big.mark = ","))
#| label: pca-small
#| warning: false
pca_small <- prcomp(wdi_noNA_small %>% select(where(is.numeric)),
center = TRUE, scale. = TRUE)
# Explained variance
tibble(PC = paste0("PC", seq_along(pca_small$sdev)),
Variance = pca_small$sdev^2 / sum(pca_small$sdev^2)) %>%
ggplot(aes(PC, Variance)) +
geom_col() +
labs(title = "Explained variance - small dataset", y = "Proportion of variance") +
theme_minimal()
# First four principal components (rotation matrix)
as.data.frame(pca_small$rotation[, 1:4]) %>%
rownames_to_column("variable") %>%
pivot_longer(-variable, names_to = "PC", values_to = "Loading") %>%
ggplot(aes(variable, Loading)) +
geom_col() +
facet_wrap(~PC) +
coord_flip() +
labs(title = "Loadings of PC1 to PC4 - small dataset", x = NULL) +
theme_minimal()
# Countries in PC1/PC2 coordinates
bind_cols(wdi_noNA_small, as.data.frame(pca_small$x[, 1:2])) %>%
ggplot(aes(PC1, PC2, color = region, label = iso3c)) +
geom_text(size = 3) +
labs(title = "Countries on PC1 and PC2 - small dataset") +
theme_minimal()
#| label: pca-large
#| warning: false
pca_large <- prcomp(wdi_noNA_large %>% select(where(is.numeric)),
center = TRUE, scale. = TRUE)
tibble(PC = paste0("PC", seq_along(pca_large$sdev)),
Variance = pca_large$sdev^2 / sum(pca_large$sdev^2)) %>%
ggplot(aes(PC, Variance)) +
geom_col() +
labs(title = "Explained variance - large dataset", y = "Proportion of variance") +
theme_minimal()
as.data.frame(pca_large$rotation[, 1:4]) %>%
rownames_to_column("variable") %>%
pivot_longer(-variable, names_to = "PC", values_to = "Loading") %>%
ggplot(aes(variable, Loading)) +
geom_col() +
facet_wrap(~PC) +
coord_flip() +
labs(title = "Loadings of PC1 to PC4 - large dataset", x = NULL) +
theme_minimal()
bind_cols(wdi_noNA_large, as.data.frame(pca_large$x[, 1:2])) %>%
ggplot(aes(PC1, PC2, color = region, label = iso3c)) +
geom_text(size = 3) +
labs(title = "Countries on PC1 and PC2 - large dataset") +
theme_minimal()
#| label: pca-extremes
# Countries with the lowest and highest PC1/PC2 scores
extremes <- function(df, pca, pc) {
o <- order(pca$x[, pc])
list(lowest = head(df$country[o], 5), highest = tail(df$country[o], 5))
}
extremes(wdi_noNA_small, pca_small, 1)
extremes(wdi_noNA_small, pca_small, 2)
extremes(wdi_noNA_large, pca_large, 1)
extremes(wdi_noNA_large, pca_large, 2)
